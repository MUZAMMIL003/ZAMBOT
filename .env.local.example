# ---------------------------------------------------------------------------
# DEMO MODE
# With this file absent (or VITE_API_URL unset), the frontend runs against a
# built-in mock backend: press "Launch Zambot", browse sample documents and
# conversations, upload files and watch them process. Nothing else needs to
# be running.
#
# To connect the real backend, copy this file to .env.local and set
# VITE_API_URL below. Demo mode then switches itself off automatically.
# ---------------------------------------------------------------------------

# URL of the Zambot backend on Render (no trailing slash).
# Local development: http://localhost:8000
# VITE_API_URL=http://localhost:8000

# Force demo mode on or off regardless of the URL above ("true" / "false").
# VITE_DEMO_MODE=true

# Sign-in (Supabase Auth). Both values are public and safe in the browser:
# Supabase -> Project Settings -> Data API -> Project URL, and
# Project Settings -> API Keys -> the "anon" / Publishable key.
# Never put the service_role / Secret key here.
# VITE_SUPABASE_URL=https://abcdxyz.supabase.co
# VITE_SUPABASE_ANON_KEY=
